# required
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
JWT_SECRET="at-least-32-random-characters"
PORT=4000

# public URL of the frontend (used in emails and bot buttons)
# APP_URL="https://your-frontend.example.com"

# optional: comma-separated origins allowed to call the API directly
# CORS_ORIGIN="https://example.com"

# optional: email via Resend (without a key, emails are skipped)
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Slotly <onboarding@resend.dev>"

# required for the scheduled reminders endpoint (32+ characters)
# CRON_SECRET="at-least-32-random-characters"

# optional: Telegram bot (create one with @BotFather)
# TELEGRAM_BOT_TOKEN="123456789:your-bot-token"
# TELEGRAM_BOT_USERNAME="slotly_test_bot"
# TELEGRAM_WEBHOOK_SECRET="32-to-256-chars-of-A-Z-a-z-0-9-_-"

# optional: a separate database used only by integration tests (never your real one)
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"